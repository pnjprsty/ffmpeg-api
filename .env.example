# FFmpeg API Environment Configuration Template
# Copy this file to .env and modify as needed

# Output directory path
# Production: /output
# Development: /tmp/ffmpeg-output
# Custom: specify any writable directory
OUTPUT_DIR=/output

# Render timeout in seconds (default: 300)
RENDER_TIMEOUT=300

# FastAPI server settings
HOST=127.0.0.1
PORT=9000
RELOAD=true
LOG_LEVEL=info

# Docker container user settings (optional)
PUID=1000
PGID=1000

# Docker volume paths (optional)
VOLUME_OUTPUT=./output
VOLUME_IMAGES=/home/gli-panji/generated-images