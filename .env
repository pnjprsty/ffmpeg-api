# FFmpeg API Environment Configuration

# Output directory path
# Production: /output (requires sudo mkdir -p /output && sudo chown $USER:$USER /output)
# Development: /tmp/ffmpeg-output (auto-fallback if /output fails)
# Custom: specify any writable directory path
OUTPUT_DIR=

# Render timeout in seconds
RENDER_TIMEOUT=300

# FastAPI settings
HOST=127.0.0.1
PORT=9000
RELOAD=true
LOG_LEVEL=info
